# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Stringa di connessione diretta al database, usata SOLO da `npm run migra`
# per applicare le migrazioni. Dashboard Supabase → pulsante Connect in alto
# → scheda ORMs (o "URI") → copia la stringa postgresql:// e sostituisci
# [YOUR-PASSWORD] con la password del database scelta alla creazione.
SUPABASE_DB_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Chiave di servizio: BYPASSA la RLS. Solo lato server, mai in un componente
# client, mai committata. Serve agli script di amministrazione e alla sola
# scrittura dell'esito PEC (che deve essere impossibile dal browser).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ------------------------------------------------------------------ PEC
# Casella PEC da cui parte il verbale di consegna. Esempi di host:
#   Aruba       smtps.pec.aruba.it        porta 465
#   Register.it smtps.pec.register.it     porta 465
#   Poste       smtp-as.postecert.it      porta 465 (o 25 con STARTTLS)
# Nota Poste: il nome "smtps.postecert.it" non esiste nel DNS; l'host corretto,
# intestato anche nel certificato TLS, è smtp-as.postecert.it. La 465 è spesso
# bloccata dalle reti mobili/hotspot: in quel caso usare la 25 con STARTTLS.
PEC_HOST=smtp-as.postecert.it
PEC_PORT=465
PEC_USER=studio@pec.esempio.it
PEC_PASSWORD=
# Mittente: deve coincidere con la casella PEC autenticata.
PEC_MITTENTE=studio@pec.esempio.it
# Destinatari, separati da virgola. Tipicamente la tua stessa PEC (auto-invio):
# è quello che dà data certa al contenuto.
PEC_DESTINATARI=studio@pec.esempio.it
# Tetto del gestore per l'INTERO messaggio (Poste ~100 MB, altri ~30-50 MB:
# verificare nel proprio pannello). Gli allegati viaggiano in base64, che
# gonfia i file di un terzo, quindi lo spazio utile reale è circa il 70%.
# I file si allegano dal più leggero finché c'è posto; di quelli che non
# entrano viaggia l'impronta SHA-256. Descrizione e script vanno SEMPRE
# integrali: sono testo, non pesano.
PEC_MAX_MESSAGGIO_MB=100
